{
  "files.encoding": "utf8",
  "files.autoGuessEncoding": true,
  "files.associations": {
    "*.vs": "glsl",
    "*.fs": "glsl"
  },
  "files.exclude": {
    "**/.DS_Store": true,
    "build": false
  },
  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.default.compilerPath": "/usr/bin/clang++",
  "terminal.integrated.cwd": "${workspaceFolder}"
}
